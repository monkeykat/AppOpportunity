# Database Configuration
DATABASE_PATH=app_scout.db
VALIDATOR_DATABASE_PATH=app_validator.db

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
SCOUT_OLLAMA_MODEL=qwen3.8:27b
INVESTIGATOR_OLLAMA_MODEL=qwen3.8:27b
VALIDATOR_OLLAMA_MODEL=qwen3.8:27b
DEFINITION_OLLAMA_MODEL=qwen3.8:27b
DEFINITION_OLLAMA_TIMEOUT_SECONDS=900

# Search Configuration
MAX_RESULTS_PER_QUERY=100
APPS_PER_RUN=20
SEARCH_QUERY_COUNT=10
MAX_APP_RATING=3.6
MIN_INSTALL_COUNT=50000
MAX_INSTALL_COUNT=10000000

# Evaluation Threshold
OPPORTUNITY_THRESHOLD=6

# Rate Limiting
REQUEST_DELAY_SECONDS=2

# Continuous Runner (seconds; 0 means run until interrupted, 3600=1 hour)
SCOUT_CONTINUOUS_RUN_DURATION_SECONDS=39600
INVESTIGATOR_CONTINUOUS_RUN_DURATION_SECONDS=3600
VALIDATOR_CONTINUOUS_RUN_DURATION_SECONDS=3600
PRODUCT_DEFINITION_CONTINUOUS_RUN_DURATION_SECONDS=3600
